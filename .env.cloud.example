# OMem Cloud — Docker + Postgres configuration
# Copy to .env.cloud:  cp .env.cloud.example .env.cloud
# Then edit POSTGRES_PASSWORD and OMEM_API_KEY before running.

# ── Database credentials ───────────────────────────────────────────────────────
POSTGRES_USER=omem
POSTGRES_PASSWORD=change_me_before_deploy
POSTGRES_DB=omem

# ── API authentication ─────────────────────────────────────────────────────────
# Leave empty for open dev mode; set a strong value before sharing with anyone.
OMEM_API_KEY=

# ── CORS (comma-separated origins, no wildcards in production) ─────────────────
OMEM_CORS_ORIGINS=http://localhost,https://localhost,http://localhost:3000

# ── Memory backend ────────────────────────────────────────────────────────────
OMEM_BACKEND=postgres
OMEM_DB_URL=postgresql://omem:change_me_before_deploy@omem-db:5432/omem

# ── Sidecar SQLite files (state / audit / runtime) ────────────────────────────
OMEM_STATE_DB_PATH=/data/omem_state.db
OMEM_AUDIT_DB_PATH=/data/omem_audit.db
OMEM_RUNTIME_DB_PATH=/data/omem_runtime.db

# ── Runtime settings ──────────────────────────────────────────────────────────
OMEM_NAMESPACE=default
OMEM_CLOUD_MODE=1
OMEM_LOG_LEVEL=INFO
OMEM_LOG_FORMAT=json

# ── Worker ────────────────────────────────────────────────────────────────────
OMEM_MAINTAIN_INTERVAL_SEC=3600

# ── Rate limiting (requests per minute per IP) ────────────────────────────────
OMEM_RATE_LIMIT=120

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── RBAC (comma-separated allowed roles; empty = no enforcement) ──────────────
# OMEM_ALLOWED_ROLES=admin,writer,reader
