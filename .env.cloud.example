# OMem Cloud — local Docker + Postgres (mirrors Linode tech preview)
# Copy to .env.cloud:  cp .env.cloud.example .env.cloud

# Optional API key (leave empty for open dev mode)
OMEM_API_KEY=

# Multi-tenant namespace root (demo)
OMEM_NAMESPACE=default

# Cloud mode flag
OMEM_CLOUD_MODE=1

# Memory backend — Postgres in Docker Compose
OMEM_BACKEND=postgres
OMEM_DB_URL=postgresql://omem:omem@omem-db:5432/omem

# Sidecar SQLite files for state / audit / runtime (same pattern as Linode preview)
OMEM_STATE_DB_PATH=/data/omem_state.db
OMEM_AUDIT_DB_PATH=/data/omem_audit.db
OMEM_RUNTIME_DB_PATH=/data/omem_runtime.db

OMEM_LOG_LEVEL=INFO
