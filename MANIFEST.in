# Files that must travel with the source distribution so that:
#  (a) the sdist can be verified / audited without the git repo
#  (b) optional Rust compilation works when rustc IS available

# Project metadata
include README.md
include LICENSE
include CHANGELOG.md
include pyproject.toml
include setup.py

# Rust extension sources (compiled only when rustc is present; ignored otherwise)
recursive-include rust *.toml *.lock *.rs *.txt
include rust/Cargo.toml
include rust/Cargo.lock

# All Python source
recursive-include omem *.py py.typed

# Documentation referenced from the README
recursive-include docs *.md

# Exclude build artefacts that should never end up in the sdist
global-exclude __pycache__
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.pyd
global-exclude .DS_Store
prune .git
prune .github
prune dist
prune build
prune *.egg-info
